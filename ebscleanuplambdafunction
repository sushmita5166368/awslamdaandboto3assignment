import os
import boto3
from datetime import datetime, timezone, timedelta

# Configuration
VOLUME_ID = os.environ.get("EBS_VOLUME_ID", "vol-0123456789abcdef0")
TAG_KEY = "CreatedBy"
TAG_VALUE = "Lambda-Backup"
RETENTION_DAYS = 30

ec2_client = boto3.client("ec2")

def lambda_handler(event, context):
    created_snapshots = []
    deleted_snapshots = []

    # 1. Create snapshot for the specified volume
    print(f"Creating snapshot for volume: {VOLUME_ID}")
    snapshot_response = ec2_client.create_snapshot(
        VolumeId=VOLUME_ID,
        Description=f"Automated backup generated by Lambda for volume {VOLUME_ID}",
        TagSpecifications=[
            {
                'ResourceType': 'snapshot',
                'Tags': [
                    {'Key': TAG_KEY, 'Value': TAG_VALUE},
                    {'Key': 'Name', 'Value': f"Backup-{VOLUME_ID}"}
                ]
            }
        ]
    )
    new_snapshot_id = snapshot_response['SnapshotId']
    created_snapshots.append(new_snapshot_id)
    print(f"Successfully created Snapshot ID: {new_snapshot_id}")

    # 2. List snapshots tagged CreatedBy=Lambda-Backup owned by 'self'
    print(f"Listing snapshots with tag {TAG_KEY}={TAG_VALUE}...")
    describe_response = ec2_client.describe_snapshots(
        OwnerIds=['self'],
        Filters=[
            {'Name': f'tag:{TAG_KEY}', 'Values': [TAG_VALUE]},
            {'Name': 'volume-id', 'Values': [VOLUME_ID]}
        ]
    )

    # Calculate cutoff time (timezone-aware UTC)
    now = datetime.now(timezone.utc)
    cutoff_time = now - timedelta(days=RETENTION_DAYS)

    # 3. Iterate through snapshots and delete those older than 30 days
    for snapshot in describe_response.get('Snapshots', []):
        snap_id = snapshot['SnapshotId']
        start_time = snapshot['StartTime']  # Returned as timezone-aware datetime

        if start_time < cutoff_time:
            print(f"Deleting snapshot {snap_id} (Created at: {start_time})...")
            try:
                ec2_client.delete_snapshot(SnapshotId=snap_id)
                deleted_snapshots.append(snap_id)
            except Exception as e:
                print(f"Error deleting snapshot {snap_id}: {str(e)}")

    # 4. Log affected resource IDs
    print("\n--- Execution Summary ---")
    print(f"Created Snapshots: {created_snapshots}")
    print(f"Deleted Snapshots: {deleted_snapshots}")

    return {
        'statusCode': 200,
        'body': {
            'createdSnapshots': created_snapshots,
            'deletedSnapshots': deleted_snapshots
        }
    }
